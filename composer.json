{
  "name": "uams-web/uams-search",
  "description": "UAMS-owned WordPress multisite search without external search services",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": { "php": ">=8.2", "ext-mbstring": "*", "ext-zlib": "*", "ext-json": "*", "ext-iconv": "*" },
  "require-dev": {
    "laravel/pint": "^1.32",
    "pestphp/pest": "^5.3",
    "php-stubs/wordpress-stubs": "^6.8",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/phpstan": "^2.3",
    "rector/rector": "^2.8",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "test": "pest",
    "mutate": "@php -d pcov.directory=. vendor/bin/pest --mutate",
    "setup:integration": "@composer install --working-dir=tests/Integration",
    "test:integration": "@php tests/Integration/vendor/bin/phpunit --configuration tests/Integration/phpunit.xml",
    "build": "node scripts/build-zip.mjs",
    "stan": "phpstan analyse --no-progress --memory-limit=2G",
    "refactor": "rector",
    "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
    "test:refactor": "rector --dry-run",
    "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
    "pint": "pint",
    "test:pint": "pint --test"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.4.27"
    },
    "sort-packages": true
  }
}
