#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

step() {
    local label="$1"
    shift
    printf '\n==> %s\n' "$label"
    time "$@"
}

packages=(php8.2-cli php8.2-mbstring php8.2-xml php8.2-curl php8.2-zip composer poppler-utils python3)
missing=()
for package in "${packages[@]}"; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done

if ((${#missing[@]})); then
    step 'Refresh system package index' sudo -n apt-get update
    step 'Install PHP, Composer, PDF and build tools' sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

step 'Check PHP version and locked platform requirements' php -r 'if (PHP_VERSION_ID < 80200) { fwrite(STDERR, "The locked test dependencies require PHP 8.2 or newer.\n"); exit(1); }'
step 'Install locked Composer dependencies' composer install --no-interaction --prefer-dist --no-progress
step 'Install locked browser test dependencies' npm ci --no-audit --no-fund

if ! ./node_modules/.bin/playwright install-deps --dry-run chromium; then
    step 'Install Chromium system dependencies' ./node_modules/.bin/playwright install-deps chromium
fi
step 'Install matching Chromium browser' ./node_modules/.bin/playwright install chromium

printf '\nOrb setup ready: composer test, composer build, npm run test:browser, npm run test:rebuild-browser\n'
